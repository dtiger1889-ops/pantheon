#!/usr/bin/env bash
# tools_show -- print the tool inventory (slash skills, guards, hooks per model, with the
# Claude/Codex sync mark) as JSON. Read-only: this never writes to ~/.claude, ~/.codex or
# ~/.agents/skills.
#   bin/tools_show | less
#   bin/tools_show > tools-snapshot.json     # to diff across machines
PANTHEON_ROOT_DEFAULT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${PANTHEON_ROOT:-$PANTHEON_ROOT_DEFAULT}"
# The MSYS2 venv always lives at the real project root, even when ROOT points at a worktree.
PY="$PANTHEON_ROOT_DEFAULT/.venv/bin/python"
export PATH="/usr/bin:$PATH" MSYSTEM=MSYS
export PYTHONUNBUFFERED=1
cd "$ROOT" || exit 1

if [ ! -x "$PY" ]; then
  echo "could not find the MSYS2 venv python at $PY" >&2
  exit 1
fi

exec "$PY" -m pantheon.tools.show
