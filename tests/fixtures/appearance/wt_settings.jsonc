// This is the user's Windows Terminal settings.json (a fixture copy).
// Comments and key order matter -- he hand-maintains this file.
{
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "defaultProfile": "{11111111-1111-1111-1111-111111111111}",

    "profiles":
    {
        "defaults":
        {
            // Empty on purpose in this fixture; the matched profile below has its own font.
        },
        "list":
        [
            {
                "guid": "{11111111-1111-1111-1111-111111111111}",
                "name": "Pantheon",
                "commandline": "C:\\msys64\\usr\\bin\\bash.exe -l -c \"ssh -t localhost\"",
                /* the deck's profile */
                "font":
                {
                    "face": "Cascadia Mono",
                    "size": 11
                },
                "colorScheme": "Campbell"
            },
            {
                "guid": "{22222222-2222-2222-2222-222222222222}",
                "name": "Windows PowerShell",
                "commandline": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
            }
        ]
    }
}
